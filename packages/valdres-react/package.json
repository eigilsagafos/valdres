{
    "name": "valdres-react",
    "description": "React bindings for Valdres state management",
    "version": "1.0.0-beta.6",
    "license": "MIT",
    "author": {
        "name": "Eigil Sagafos"
    },
    "homepage": "https://valdres.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eigilsagafos/valdres.git"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./inspect": "./src/inspect.tsx"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "NODE_ENV=production bun build.ts",
        "build:types": "rm -rf dist/types && bunx tsgo && bun run ../../scripts/rewrite-declaration-imports.ts dist/types",
        "test": "bun test --reporter=dots --parallel"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.0.5",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@valdres/test": "workspace:^",
        "happy-dom": "20.0.5",
        "mitata": "0.1.14",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "react-test-renderer": "19.1.1",
        "recoil": "0.7.7",
        "typescript": "5.9.2",
        "valdres": "workspace:^"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "valdres": "^1.0.0-beta.27"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
