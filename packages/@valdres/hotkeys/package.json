{
    "name": "@valdres/hotkeys",
    "description": "Keyboard shortcuts as synchronous Valdres transactions",
    "version": "1.0.0-beta.8",
    "license": "MIT",
    "author": {
        "name": "Eigil Sagafos"
    },
    "homepage": "https://valdres.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eigilsagafos/valdres.git"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./adapter-internals": "./src/adapter-internals.ts"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "NODE_ENV=production bun build.ts",
        "build:types": "rm -rf dist/types && bunx tsgo && bun run ../../../scripts/rewrite-declaration-imports.ts dist/types",
        "typecheck:tests": "bunx tsgo --noEmit -p tsconfig.tests.json",
        "test": "bun test"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.0.5",
        "@valdres/browser-keyboard": "workspace:^",
        "happy-dom": "20.0.5",
        "typescript": "5.9.2",
        "valdres": "workspace:^"
    },
    "peerDependencies": {
        "@valdres/browser-keyboard": "^1.0.0-beta.10",
        "valdres": "^1.0.0-beta.41"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
