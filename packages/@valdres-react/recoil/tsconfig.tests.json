{
    // Type-checks everything the package ships or runs; `tsconfig.json`
    // narrows to the entry for declaration emit.
    "extends": "../../../tsconfig.json",
    "include": ["src", "test"],
    "exclude": ["dist"],
    "compilerOptions": {
        "noEmit": true,
        "resolveJsonModule": true,
        "types": ["bun"]
    }
}
