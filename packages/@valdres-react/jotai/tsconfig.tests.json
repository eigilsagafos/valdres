{
    // Type-checks everything the package ships or runs; `tsconfig.json`
    // narrows to the entry for declaration emit.
    "extends": "../../../tsconfig.json",
    "include": ["src", "test"],
    // Upstream Jotai tests are typed against Jotai's own API (for example its
    // read `signal`); they run against both implementations instead.
    "exclude": [
        "dist",
        "test/upstream/**/*.test.ts",
        "test/upstream/**/*.test.tsx",
        "test/packed/fixtures"
    ],
    "compilerOptions": {
        "noEmit": true,
        "types": ["bun"]
    }
}
