{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://valdres.dev/contracts/v1/target-surface-catalog.schema.json",
    "title": "Valdres v1 reviewed target surface catalog",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "schemaVersion",
        "completeness",
        "publicApiIds",
        "callbackIds",
        "independentBetaPublicApiIds",
        "frozenPublicCoordinates"
    ],
    "properties": {
        "$schema": { "const": "./schemas/target-surface-catalog.schema.json" },
        "schemaVersion": { "const": 1 },
        "completeness": { "enum": ["partial", "complete"] },
        "publicApiIds": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]+$"
            },
            "uniqueItems": true
        },
        "callbackIds": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]+$"
            },
            "uniqueItems": true
        },
        "independentBetaPublicApiIds": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]+$"
            },
            "uniqueItems": true
        },
        "frozenPublicCoordinates": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "package", "subpath", "name"],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9.-]+$"
                    },
                    "package": { "type": "string", "minLength": 1 },
                    "subpath": { "type": "string", "minLength": 1 },
                    "name": { "type": "string", "minLength": 1 }
                }
            },
            "uniqueItems": true
        }
    }
}
