{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://valdres.dev/contracts/v1/legacy-disposition-catalog.schema.json",
    "title": "Reviewed legacy coordinate to migration disposition ownership",
    "type": "object",
    "additionalProperties": false,
    "required": ["$schema", "schemaVersion", "entries"],
    "properties": {
        "$schema": {
            "const": "./schemas/legacy-disposition-catalog.schema.json"
        },
        "schemaVersion": { "const": 1 },
        "entries": {
            "type": "array",
            "items": { "$ref": "#/$defs/entry" }
        }
    },
    "$defs": {
        "legacyKind": {
            "enum": [
                "runtime-export",
                "type-export",
                "property",
                "method",
                "overload",
                "option"
            ]
        },
        "coordinate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "package", "subpath", "name", "baseline"],
            "properties": {
                "kind": { "$ref": "#/$defs/legacyKind" },
                "package": { "type": "string", "minLength": 1 },
                "subpath": { "type": "string", "minLength": 1 },
                "owner": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "baseline": { "type": "string", "minLength": 1 }
            }
        },
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["coordinate", "dispositionId", "reviewStatus"],
            "properties": {
                "coordinate": { "$ref": "#/$defs/coordinate" },
                "dispositionId": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9.-]+$"
                },
                "reviewStatus": { "enum": ["proposed", "approved"] }
            }
        }
    }
}
