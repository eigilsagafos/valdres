{
    "compilerOptions": {
        // Enable latest features
        "lib": ["ESNext", "DOM"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleDetection": "force",
        "jsx": "react-jsx",
        "allowJs": true,

        // Bundler mode
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,

        // Best practices
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,

        // Reject unused imports/locals repo-wide (gated in CI via `bun run
        // typecheck`). noUnusedParameters is left off deliberately: unused
        // params are common in callbacks/interface implementations and it has a
        // much wider blast radius.
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false
    }
}
